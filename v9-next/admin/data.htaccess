# Nahrá sa ako /data/.htaccess: v priečinku s nahratými súbormi nesmie bežať žiadny skript
Options -Indexes
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh|htaccess)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.lock$|\.tmp$">
  Require all denied
</FilesMatch>
<FilesMatch "\.json$">
  Header set Cache-Control "no-store"
</FilesMatch>
